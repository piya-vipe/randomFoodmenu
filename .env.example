DATABASE_URL="postgresql://user:password@localhost:5432/menu_picker?schema=public"

# Any secret string. Required to view /insights (analytics dashboard).
INSIGHTS_KEY="change-me"

# Key for /admin and /admin/users. Falls back to INSIGHTS_KEY if unset.
ADMIN_KEY="change-me-too"

# Optional. Enables the Google Map on /admin/users. Without it, that page
# still lists coordinates with links out to Google Maps.
# Needs "Maps JavaScript API" enabled on the key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
